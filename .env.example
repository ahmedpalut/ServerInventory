# =====================================================================
# GIG Server Inventory & Management System - Environment Template
# Copy this file to '.env' and fill in your environment configuration.
# =====================================================================

# Flask Application Secret Key (Required for sessions)
SECRET_KEY=super_secret_key_change_me_in_production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=sunucu_envanteri

# Windows Service Name for MySQL (Used by Database Maintenance tab)
MYSQL_SERVICE=MySQL80

# Active Directory (AD) / LDAP Integration Configuration
# Set AD_SERVER to your Domain Controller IP or FQDN (e.g., ldap://192.168.1.10:389)
LDAP_SERVER=ldap://192.168.1.10:389
LDAP_DOMAIN=gig.net.tr

# Optional Active Directory Service Account Credentials
# (If left empty, admins can type their own credentials in the UI modal)
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Optional Custom LDAP Search Base (e.g., OU=Computers,DC=gig,DC=net,DC=tr)
LDAP_SEARCH_BASE=
LDAP_TARGET_OU=
